# cairnmcp self-host settings. Copy to .env next to compose.yaml and fill in.
# Never commit .env. Every setting the app reads is here; the app checks them at
# startup and refuses to start, naming each problem, if something is missing or wrong.

# --- What runs -------------------------------------------------------------------------
# Optional parts: postgres (bundled database), dex (local demo sign-in), caddy (HTTPS).
# Laptop: postgres,dex. Server with a domain: postgres,caddy (and a real sign-in provider).
COMPOSE_PROFILES=postgres,dex

# The image. Pin a version on a server (e.g. ghcr.io/cairnmcp/cairnmcp:0.1) and change it
# to upgrade; see README.md.
CAIRNMCP_IMAGE=ghcr.io/cairnmcp/cairnmcp:latest

# --- Required --------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts the API keys you store (it wraps each tenant's data
# key). Losing it means re-entering every key; back it up apart from the database.
# Generate: openssl rand -base64 32
CAIRNMCP_MASTER_KEY=

# Password for the bundled Postgres roles. Generate: openssl rand -hex 24
# Only used with the postgres profile, and only on the first start (an empty database
# volume); changing it later doesn't change the roles' passwords.
CAIRNMCP_POSTGRES_PASSWORD=

# Public base URL, origin only: https, or http for localhost. It is also the issuer of the
# tokens cairnmcp gives MCP clients, so changing it signs everyone out. MCP endpoints are
# <url>/mcp/<tenant>/<toolset>; the console is <url>/app/.
CAIRNMCP_PUBLIC_URL=http://localhost:8080

# Where people sign in (OpenID Connect providers), as JSON on one line. At least one.
# Register <CAIRNMCP_PUBLIC_URL>/oauth/callback/<id> and <CAIRNMCP_PUBLIC_URL>/app/callback/<id>
# as redirect URIs with each provider. This default is the bundled Dex (profile "dex").
# Google: [{"id":"google","name":"Google","issuer":"https://accounts.google.com","clientId":"…","clientSecret":"…"}]
CAIRNMCP_OIDC_PROVIDERS=[{"id":"dex","name":"Dex (local demo)","issuer":"http://localhost:5556/dex","clientId":"cairnmcp","clientSecret":"cairnmcp-local-dex-not-a-secret"}]

# --- Your own Postgres (instead of the postgres profile) -------------------------------
# The app's role: not the owner, not a superuser, no BYPASSRLS. Roles: packages/db/README.md.
# CAIRNMCP_DATABASE_URL=postgres://cairnmcp_server:…@db.example.com:5432/cairnmcp
# The owner role, used only by the migration step.
# CAIRNMCP_DATABASE_OWNER_URL=postgres://cairnmcp_owner:…@db.example.com:5432/cairnmcp

# --- HTTPS with the caddy profile ------------------------------------------------------
# Your domain, with a DNS A/AAAA record pointing here and ports 80 and 443 open.
# Set CAIRNMCP_PUBLIC_URL=https://<this domain> to match.
CAIRNMCP_DOMAIN=

# --- Optional --------------------------------------------------------------------------
# Other authorization servers whose tokens the MCP endpoint accepts, as JSON. The embedded
# one is always trusted.
# [{"issuer":"https://auth.example.com","jwksUri":"https://auth.example.com/.well-known/jwks.json"}]
CAIRNMCP_TRUSTED_ISSUERS=

# Browser origins allowed to call the MCP endpoint, comma-separated. Others get 403.
CAIRNMCP_ALLOWED_ORIGINS=

# Where the app's port is published on this machine. 127.0.0.1 keeps it local (Caddy
# reaches it over Docker's network either way); 0.0.0.0 exposes plain http to the network.
CAIRNMCP_BIND=127.0.0.1
CAIRNMCP_PORT=8080
