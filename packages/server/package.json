{
  "name": "@procura/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The procura app: the authorization server and the MCP endpoint in one process, configured from the environment.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env.local scripts/serve.ts",
    "dev:console": "node scripts/dev-console.ts"
  },
  "dependencies": {
    "@procura/auth": "workspace:*",
    "@procura/console-api": "workspace:*",
    "@procura/core": "workspace:*",
    "@procura/db": "workspace:*",
    "@procura/http": "workspace:*",
    "@procura/ingest": "workspace:*",
    "@procura/mcp": "workspace:*",
    "@procura/runtime": "workspace:*",
    "@procura/vault": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jose": "^6.2.17"
  }
}
