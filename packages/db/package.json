{
  "name": "@procura/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Postgres storage with row-level security: tenants, members, sources, toolsets, vault, audit.",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./src/test-support.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=../../.env.local scripts/migrate.ts",
    "roles": "node --env-file-if-exists=../../.env.local scripts/create-app-role.ts"
  },
  "dependencies": {
    "@procura/core": "workspace:*",
    "@procura/runtime": "workspace:*",
    "@procura/vault": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@procura/ingest": "workspace:*",
    "@types/pg": "^8.23.1"
  }
}
