{
  "name": "cairnmcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --no-bail typecheck",
    "check": "pnpm typecheck && pnpm test",
    "ir:dump": "pnpm --filter @cairnmcp/ingest ir:dump",
    "eval:ingest": "pnpm --filter @cairnmcp/eval eval:ingest",
    "example:intervals": "pnpm --filter @cairnmcp/example-intervals-icu start"
  },
  "devDependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
