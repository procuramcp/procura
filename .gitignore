node_modules/
out/
coverage/
*.tsbuildinfo
.DS_Store

# Secrets: never commit. Use .env.example for documented, empty placeholders.
.env
.env.*
!.env.example

# Real training/wellness exports stay local.
data/
exports/
*.fit
*.fit.gz

# Agent skills installed locally (npx neon skills); not part of the project.
.claude/skills/
skills-lock.json
.neon

# Oracle VM settings and secrets (written by deploy/oracle/setup-vm.sh).
deploy/oracle/.env
deploy/oracle/*.env

# Terraform (deploy/oracle/infra): local state and settings stay out of git; the lock file is committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
