# Copy to .env (gitignored) and fill in. Never commit real values.

# Intervals.icu API key: Intervals.icu → Settings → Developer Settings.
# Used only by `pnpm try:intervals` on your machine.
INTERVALS_API_KEY=

# 32 random bytes, base64. Wraps per-tenant data keys in the vault.
# Generate: openssl rand -base64 32
# Optional for try:intervals (a throwaway key is used if empty); required for the server.
CAIRNMCP_MASTER_KEY=
