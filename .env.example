# Copy to .env (gitignored) and fill in. Never commit real values.
# cairnmcp's own settings only; API-specific settings live with each example.

# 32 random bytes, base64. Wraps per-tenant data keys in the vault. Required for the server.
# Generate: openssl rand -base64 32
CAIRNMCP_MASTER_KEY=

# Postgres as the app role (not the owner, not a superuser, no BYPASSRLS). Required for the server.
# See packages/db/README.md for the role setup.
CAIRNMCP_DATABASE_URL=

# Postgres as the owner role. Only for running migrations: pnpm --filter @cairnmcp/db migrate
CAIRNMCP_DATABASE_OWNER_URL=

# Tests only: a superuser URL for the tenant isolation tests (they skip without it).
# CAIRNMCP_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Public base URL of the MCP endpoint, origin only (https; http only for localhost).
# Endpoints are <url>/mcp/<tenant>/<toolset>, and tokens must be issued for exactly that URL.
CAIRNMCP_PUBLIC_URL=

# Authorization servers whose tokens the endpoint accepts, as JSON:
# [{"issuer":"https://auth.example.com","jwksUri":"https://auth.example.com/.well-known/jwks.json"}]
CAIRNMCP_TRUSTED_ISSUERS=

# Optional: browser origins allowed to call the endpoint, comma-separated. Others get 403.
CAIRNMCP_ALLOWED_ORIGINS=

# Optional: port to listen on (default 8080).
PORT=
